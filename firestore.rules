rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Ayudantes
    // ---------------------------------------------------------------
    function autenticado() { return request.auth != null; }

    function miDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esOwner() {
      return autenticado() && miDoc().rol == 'owner';
    }

    function esAdmin() {
      return autenticado() && miDoc().rol == 'admin';
    }

    function gestiona(uid) {
      return esAdmin() && (uid in miDoc().gestionados);
    }

    function esYo(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // usuarios/{uid} — perfil, rol y, si es admin, a quién gestiona.
    // Solo el owner crea cuentas y cambia roles/asignaciones (evita que
    // alguien se auto-ascienda a admin). Cada quien puede actualizar sus
    // propios campos no sensibles (ej. el token de notificaciones push).
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if esOwner() || esYo(uid) || gestiona(uid);

      allow create: if esOwner();

      allow update: if esOwner()
        || (esYo(uid)
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.gestionados == resource.data.gestionados
            && request.resource.data.activo == resource.data.activo
            && request.resource.data.nombre == resource.data.nombre
            && request.resource.data.email == resource.data.email);

      allow delete: if esOwner();
    }

    // ---------------------------------------------------------------
    // proyectos/{nombre} — catálogo de proyectos (Administración → owner).
    // Cada documento puede tener "permitidos": una lista de uids con acceso
    // especial a las tareas de ESE proyecto, sin importar a quién gestionen
    // normalmente (para proyectos confidenciales, ej. "GERENCIA"). Si no
    // existe el documento, o no tiene "permitidos", o está vacía, el
    // proyecto es "abierto" y se aplican las reglas normales de siempre.
    // Cualquiera que inició sesión puede leer el catálogo (lo necesita para
    // los selectores de la app); solo el owner lo edita.
    // ---------------------------------------------------------------
    match /proyectos/{nombre} {
      allow read: if autenticado();
      allow write: if esOwner();
    }

    function proyectoDoc(proyecto) {
      return get(/databases/$(database)/documents/proyectos/$(proyecto)).data;
    }

    // true si NO hay restricción especial para ese proyecto: cualquier jefe
    // que gestione a la persona responsable puede ver/tocar la tarea, como
    // hasta ahora.
    function proyectoAbierto(proyecto) {
      return proyecto == ""
        || !exists(/databases/$(database)/documents/proyectos/$(proyecto))
        || !('permitidos' in proyectoDoc(proyecto))
        || proyectoDoc(proyecto).permitidos.size() == 0;
    }

    // true si a MÍ puntualmente me agregaron a la lista de "permitidos" de
    // ese proyecto — acceso extra que no depende de si gestiono o no a la
    // persona responsable (ej. "otra persona que brinde apoyo").
    function estoyPermitidoEnProyecto(proyecto) {
      return proyecto != ""
        && exists(/databases/$(database)/documents/proyectos/$(proyecto))
        && 'permitidos' in proyectoDoc(proyecto)
        && request.auth.uid in proyectoDoc(proyecto).permitidos;
    }

    // ---------------------------------------------------------------
    // tareas/{id}
    // Lectura/escritura total: owner, o admin sobre su personal asignado
    // (salvo que el proyecto esté restringido — ver arriba). El propio
    // responsable (staff) puede editar el resto de los datos de SU tarea
    // (título, proyecto, prioridad, fecha, notas, estado) pero no
    // reasignarla a otra persona ni tocar quién la creó.
    //
    // IMPORTANTE: los campos "orden" y "loteId" NO existen en la mayoría de
    // las tareas (solo se usan en las que se crean repetidas en lote). Leer
    // un campo que no existe con la notación "antes.loteId" directamente
    // ES UN ERROR en las reglas de Firestore (no da "null" como en
    // JavaScript) y eso ANULABA el permiso silenciosamente — por eso el
    // personal no podía cambiar el estado de sus tareas. Por eso aquí se usa
    // antes.get('campo', null) en vez de antes.campo: así, si el campo no
    // existe, se trata como "null" en lugar de romper la regla entera.
    // ---------------------------------------------------------------
    function noReasigna() {
      let antes = resource.data;
      let despues = request.resource.data;
      return despues.get('responsableUid', null) == antes.get('responsableUid', null)
        && despues.get('creadoPorUid', null) == antes.get('creadoPorUid', null)
        && despues.get('orden', null) == antes.get('orden', null)
        && despues.get('loteId', null) == antes.get('loteId', null);
    }

    match /tareas/{id} {
      allow read: if esOwner()
        || esYo(resource.data.responsableUid)
        || (gestiona(resource.data.responsableUid) && proyectoAbierto(resource.data.proyecto))
        || estoyPermitidoEnProyecto(resource.data.proyecto);

      allow create: if autenticado()
        && request.resource.data.creadoPorUid == request.auth.uid
        && (esOwner()
            || gestiona(request.resource.data.responsableUid)
            || esYo(request.resource.data.responsableUid));

      allow update: if esOwner()
        || (gestiona(resource.data.responsableUid) && proyectoAbierto(resource.data.proyecto)
            && (request.resource.data.responsableUid == resource.data.responsableUid
                || gestiona(request.resource.data.responsableUid)))
        || (esYo(resource.data.responsableUid) && noReasigna())
        || (estoyPermitidoEnProyecto(resource.data.proyecto) && noReasigna());

      // Incluye esYo() y estoyPermitidoEnProyecto(): además de quien
      // administra, el propio responsable (o quien tenga acceso especial al
      // proyecto) puede borrar definitivamente una tarea suya ya completada
      // desde el historial de la app (ver botón "Eliminar" ahí).
      allow delete: if esOwner()
        || (gestiona(resource.data.responsableUid) && proyectoAbierto(resource.data.proyecto))
        || esYo(resource.data.responsableUid)
        || estoyPermitidoEnProyecto(resource.data.proyecto);
    }

    // ---------------------------------------------------------------
    // notificaciones/{id} — las crea únicamente la Cloud Function (con el
    // SDK de administrador, que no pasa por estas reglas). Cada quien solo
    // ve las suyas y únicamente puede marcarlas como leídas.
    // ---------------------------------------------------------------
    match /notificaciones/{id} {
      allow read: if esYo(resource.data.paraUid);
      allow update: if esYo(resource.data.paraUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow create, delete: if false;
    }

    // Todo lo demás queda cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
